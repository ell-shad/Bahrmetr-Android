{
  "_comment": [
    "TEMPLATE FILE — copy to google-services.json and fill in your own values.",
    "The real google-services.json is deliberately NOT committed (see .gitignore).",
    "",
    "What you need from the Firebase console:",
    "  1. Create a Firebase project.",
    "  2. Add an Android app with package name 'com.coriolis.bahrmetr'",
    "     (or your own package id — then change Build1= in B4A/Bahrmetr.b4a too).",
    "  3. Download the generated google-services.json and place it in B4A/.",
    "",
    "B4X note: the B4X IDE bundles a Google Services library. Do not hand-edit",
    "the downloaded file; regenerate it from the console instead."
  ],
  "project_info": {
    "project_number": "YOUR_PROJECT_NUMBER",
    "project_id": "YOUR_PROJECT_ID",
    "storage_bucket": "YOUR_PROJECT_ID.appspot.com"
  },
  "client": [
    {
      "client_info": {
        "mobilesdk_app_id": "YOUR_MOBILESDK_APP_ID",
        "android_client_info": {
          "package_name": "com.coriolis.bahrmetr"
        }
      },
      "oauth_client": [
        {
          "client_id": "YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com",
          "client_type": 3
        }
      ],
      "api_key": [
        {
          "current_key": "YOUR_API_KEY"
        }
      ],
      "services": {
        "appinvite_service": {
          "other_platform_oauth_client": [
            {
              "client_id": "YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com",
              "client_type": 3
            }
          ]
        }
      }
    }
  ],
  "configuration_version": "1"
}

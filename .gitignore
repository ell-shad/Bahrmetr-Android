# ============================================================
#  Bahrmetr — .gitignore
#  B4X/B4A projects produce a lot of machine-local build output.
#  Everything under Objects/ is regenerated by the B4X IDE and
#  must never be committed.
# ============================================================

# ---- B4X build output (41.7 MB, machine-specific) -------------
Project/*/B4A/Objects/
Project/*/B4J/Objects/
Project/*/B4i/Objects/

# IDE auto-backups (binary snapshots, ~700 KB each)
Project/*/B4A/AutoBackups/
Project/*/B4J/AutoBackups/
Project/*/B4i/AutoBackups/

# B4X IDE working files
*.b4a.meta.bak
Backup_*/

# ---- Signed build artifacts ----------------------------------
# These embed your signing certificate. Never commit them.
*.apk
*.aab
*.apks
*.ipa
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.keystore
*.jks
*.p12
*.pem
*.key
*.pfx
*.bks

# ---- Secrets / per-developer config --------------------------
# Firebase project config. Use google-services.json.example
# as the template. See SECURITY.md.
google-services.json
GoogleServices-Info.plist
agconnect-services.json
local.properties
signing.properties

# Keystore passwords sometimes live in a stray properties file
keystore.properties
signing.cfg

# ---- OS / editor cruft ---------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

*~
*.bak
*.swp
*.swo
*.orig
*.rej

.vscode/
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# ---- Windows build noise -------------------------------------
# d8_arguments.txt embeds absolute paths such as
# C:\Users\<name>\Desktop\... — see BUILD.md
d8_arguments.txt
Thumbs.db
ehthumbs.db
$RECYCLE.BIN/
SysVol/

# ---- Python (only used by data/decrypt_db.py) ----------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
